# Copie para .env e ajuste. NUNCA versione o .env (já está no .gitignore).
AMBIENTE=dev
# SQLite (padrão, não precisa instalar nada):
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (com o docker-compose.yml desta pasta ou um PostgreSQL instalado):
# DATABASE_URL=postgresql+psycopg://tcc:tcc@localhost:5432/tcc
# Gere um segredo com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_JWT=troque-este-valor
MINUTOS_TOKEN=60
ORIGENS_CORS=http://localhost:3000
